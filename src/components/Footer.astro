---
import { NAV } from '../consts'
---

<footer class="bg-[#2f2722] text-[#fbf8f4] py-10">
  <div class="max-w-6xl mx-auto px-5 flex flex-col gap-4 text-sm sm:px-6 md:flex-row md:justify-between">
    <p>&copy; 2026 Olivia Nicole</p>

    <div class="flex flex-wrap gap-4 uppercase tracking-wide md:gap-6">
      {NAV.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </div>
</footer>
