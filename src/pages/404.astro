---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_NAME, withBase } from '../consts'
---

<BaseLayout title={`Page Not Found | ${SITE_NAME}`} description="The page you’re looking for can’t be found.">
  <main class="max-w-3xl mx-auto px-5 py-24 text-center sm:px-6 md:py-32">
    <p class="uppercase tracking-[0.2em] text-sm text-[#8f766b] mb-5">404</p>
    <h2 class="text-4xl leading-none mb-8 md:text-5xl">This page wandered off.</h2>
    <p class="text-lg leading-8 text-[#5f5149] mb-12 max-w-xl mx-auto">
      The page you’re looking for doesn’t exist or may have moved. Let’s get you back on track.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href={withBase('')}
        class="bg-[#af9d93] text-[#fffaf4] px-8 py-4 rounded-2xl text-sm uppercase tracking-wide hover:bg-[#9f8b80] transition"
      >
        Home
      </a>
      <a
        href={withBase('blog/')}
        class="border border-[#af9d93] px-8 py-4 rounded-2xl text-sm uppercase tracking-wide hover:bg-[#f2e9dd] transition"
      >
        Read the Blog
      </a>
    </div>
  </main>
</BaseLayout>
